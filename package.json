{
  "name": "superloja-auto-poster",
  "version": "4.1.0",
  "description": "Automatic Facebook & Instagram poster for Superloja Angola e-commerce platform",
  "main": "auto-poster-v4.js",
  "scripts": {
    "start": "node auto-poster-v4.js",
    "post:single": "node auto-poster-v4.js single",
    "post:carousel": "node auto-poster-v4.js carousel",
    "post:stories": "node auto-poster-v4.js stories",
    "post:reels": "node auto-poster-v4.js reels",
    "dashboard": "node dashboard.js",
    "cron:setup": "echo '0 9 * * * cd C:\\Users\\fox/webhook-server && node auto-poster-v4.js single >> C:\\superloja\\data/posting-log.txt 2>&1' | crontab -",
    "cleanup": "rm -rf C:\\superloja\\data/img_cache/* && echo 'Cache cleaned'"
  },
  "keywords": [
    "facebook",
    "instagram",
    "automation",
    "social-media",
    "ecommerce"
  ],
