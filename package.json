    "form-data": "^4.0.6",
    "node-fetch": "^3.3.2",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "pdf-to-png-converter": "^4.1.1"
  }
}
