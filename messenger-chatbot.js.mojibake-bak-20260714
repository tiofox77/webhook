// â”€â”€â”€ Send Message via Messenger â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
async function sendMessage(recipientId, messageText) {
  return new Promise((resolve, reject) => {
    const body = JSON.stringify({
      recipient: { id: recipientId },
      message: { text: messageText }
    });
    
    const options = {
      hostname: 'graph.facebook.com',
      path: `/v21.0/me/messages?access_token=${PAGE_ACCESS_TOKEN}`,
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Content-Length': Buffer.byteLength(body)
      }
    };
    
    const req = https.request(options, (res) => {
      let data = '';
      res.on('data', d => data += d);
      res.on('end', () => {
        try {
          const json = JSON.parse(data);
          resolve(json);
        } catch (e) {
          reject(e);
        }
      });
    }).on('error', reject);
    
    req.write(body);
    req.end();
  });
}

// â”€â”€â”€ Log Conversation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function logConversation(senderId, senderName, messageText, intent, botResponse) {
  let convos = loadJSON(CONVERSATIONS_LOG);
  
  convos.push({
    timestamp: new Date().toISOString(),
    senderId,
    senderName,
    userMessage: messageText,
    intent,
    botResponse,
    status: 'pending_followup'
  });
  
  // Keep last 1000 conversations
  convos = convos.slice(-1000);
  saveJSON(CONVERSATIONS_LOG, convos);
  
  log('INFO', `[${senderName}] Intent: ${intent} | User: "${messageText.substring(0, 50)}"...`);
}

// â”€â”€â”€ Extract Lead Info â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function extractAndLogLead(senderId, senderName, intent) {
  if (intent !== 'purchase' && intent !== 'complaint') return;
  
  let leads = loadJSON(LEADS_LOG);
  
  // Check if lead already exists
  const existing = leads.find(l => l.senderId === senderId);
  if (existing) {
    existing.lastContact = new Date().toISOString();
    existing.intents.push(intent);
  } else {
    leads.push({
      senderId,
      name: senderName,
      firstContact: new Date().toISOString(),
      lastContact: new Date().toISOString(),
      intents: [intent],
      status: 'active',
      notes: ''
    });
  }
  
  saveJSON(LEADS_LOG, leads);
  log('INFO', `[LEAD] ${senderName} | Intent: ${intent}`);
}

// â”€â”€â”€ Handle Incoming Message â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
async function handleMessage(senderId, senderName, messageText) {
  try {
    // Classify intent
    const { intent, confidence } = classifyIntent(messageText);
    
    // Generate response
    const botResponse = generateResponse(intent, senderName);
    
    // Send reply
    await sendMessage(senderId, botResponse);
    log('INFO', `âœ… Replied to ${senderName}`);
    
    // Log conversation
    logConversation(senderId, senderName, messageText, intent, botResponse);
    
    // Extract lead if applicable
    extractAndLogLead(senderId, senderName, intent);
    
  } catch (e) {
    log('ERROR', `Failed to handle message from ${senderName}: ${e.message}`);
  }
}

