# ════════════════════════════════════════════════════════════════════════════════
# Superloja — Environment Configuration
# Local:   C:\superloja\webhook-server\.env
# Backup:  C:\superloja\webhook-server\.env-backup-2026-07-02\
# Updated: 2026-07-03 by Carlosfox + Hermes
# ════════════════════════════════════════════════════════════════════════════════

# ─── Paths ────────────────────────────────────────────────────────────────────
# Usar forward slashes: compatível com bash (source .env) E Node.js (process.env)
DATA_DIR=C:/superloja/data
ANALYTICS_DIR=C:/superloja/data/analytics
LOG_DIR=C:/superloja/data/logs
WEBHOOK_DIR=C:/superloja/webhook-server

# ─── Server Ports ─────────────────────────────────────────────────────────────
# 3335 = messenger-chatbot.js (trata /webhook + /api/conversations + /api/leads)
WEBHOOK_PORT=3335
PROXY_PORT=8080
DASHBOARD_PORT=3333
CHATBOT_PORT=3335
INTELLIGENCE_PORT=3336

# ─── Meta / Facebook ──────────────────────────────────────────────────────────
# Página Superloja (ID fixo, não muda)
# Canonical vars (usar estes em scripts novos)
FB_PAGE_ID=230190170178019
FB_PAGE_TOKEN=

# Legacy aliases (mantidos para scripts antigos — mesmos valores acima)
FACEBOOK_PAGE_ID=230190170178019
FACEBOOK_PAGE_TOKEN=
PAGE_ACCESS_TOKEN=

# User access token (usado para renovar page token via /me/accounts)
FACEBOOK_ACCESS_TOKEN=

# ─── Meta / Instagram Business ────────────────────────────────────────────────
# Vinculado à página FB 230190170178019 (Business Account)
# Canonical var
IG_PAGE_ID=17841464824215251

# Legacy aliases
INSTAGRAM_ACCOUNT_ID=17841464824215251
INSTAGRAM_ACCESS_TOKEN=

# ─── WhatsApp Business ────────────────────────────────────────────────────────
WHATSAPP_NUMBER=244954949595
WHATSAPP_LINK=https://wa.me/244954949595

# ─── Webhook Verification ─────────────────────────────────────────────────────
WEBHOOK_VERIFY_TOKEN=
VERIFY_TOKEN=superloja_webhook_secret_2026

# ─── Superloja Store API ──────────────────────────────────────────────────────
# https://superloja.vip/api/store-api/superloja/
STORE_API_URL=https://superloja.vip/api/store-api/superloja/
SUPERLOJA_API_KEY=
SUPERLOJA_API_SECRET=

# ─── Hermes / Sistema ────────────────────────────────────────────────────────
HERMES_HOME=
HERMES_CONFIG_DIR=
HOME=

# Cambio oficial USD->Kz (sourcing calcula margens com isto; actualizar de vez em quando)
CAMBIO_KZ_USD=

# Sakana Fugu — modelo de raciocínio (sourcing/campanhas); chat de clientes fica no AISA/Haiku
SAKANA_API_KEY=
SAKANA_MODEL=

# Chave do Prime Agent (WSL): entrega recomendacoes, NAO reinicia servicos
PRIME_API_KEY=
DONO_PHONE=
